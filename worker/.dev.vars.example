# Copy to `.dev.vars` and fill in. Wrangler's equivalent of .env.local —
# read by `wrangler dev` for LOCAL runs only, and gitignored.
#
# Production secrets do NOT come from here. Set them once with:
#   npx wrangler secret put RESEND_API_KEY
# and they are stored encrypted in Cloudflare.

# resend.com/api-keys — "Sending access" is enough
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Turnstile is parked. If it is ever switched back on, add the widget secret
# here for local runs (Cloudflare's always-passes test key is
# 1x0000000000000000000000000000000AA).
# TURNSTILE_SECRET=
